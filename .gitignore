# --- runtime / launcher ---
.shim/
logs/

# --- Python caches / editor ---
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/
.vscode/
.idea/

# --- robot description sources: nested git clones (pinned in docs/references.md) and the xacro venv ---
references/robot_description/turtlebot4/
references/robot_description/create3_sim/
references/robot_description/.venv_xacro/

# --- training outputs (Navigation/ and AdaptiveSensing/) ---
# TensorBoard event files (kept on disk, not versioned)
**/events.out.tfevents.*
# checkpoints: only explicitly listed (evaluated / promoted) checkpoints are versioned
Navigation/runs/**/model_*.pt
AdaptiveSensing/runs/**/model_*.pt
!Navigation/runs/NAV01_static_initial/2026-11-22_00-44-09_m5_initial_4096/model_200.pt
!Navigation/runs/NAV01_static_initial/2026-11-22_12-43-08_ppo_n4096_s42_reorg_validation/model_200.pt
# sweep launcher configs and logs
Navigation/sweeps/
AdaptiveSensing/sweeps/

# --- regression-check outputs (regenerated on every run) ---
tests/sim/results/

# --- infrastructure history ---
# 3-iteration smoke-test runs
infrastructure/M5_initial_navigation/results/runs/*_smoke/
# regenerable robot-visualization exports (infrastructure/robot_viz/scripts/export_robot_geometry.py)
infrastructure/robot_viz/results/*.glb
